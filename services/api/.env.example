NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-local-database-password
DB_NAME=lmui-website

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Public site origin(s) allowed to call this API from the browser (admin app + web app)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Next.js public site's on-demand revalidation endpoint + shared secret,
# called right after a homepage publish so the change is live immediately.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-too

UPLOADS_DIR=./uploads
